# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="change-me-with-a-long-random-secret-at-least-32-chars"
ENCRYPTION_SECRET="change-me-with-another-long-random-secret-32-chars"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fisclink?schema=public"

# Queue
REDIS_URL="redis://localhost:6379"

# Email
# In development, login links are also printed in the console.
RESEND_API_KEY=""
EMAIL_FROM="FiscLink <noreply@example.com>"

# Optional: Stripe CLI webhook testing
# stripe listen --forward-to "localhost:3000/api/webhooks/stripe?merchant=YOUR_MERCHANT_ID"

# Optional: provider integrations are configured per merchant in the dashboard.
