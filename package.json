{
  "name": "fisclink",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "pnpm exec tsx src/lib/workers/start.ts",
    "db:migrate": "pnpm exec prisma migrate deploy",
    "db:migrate:dev": "pnpm exec prisma migrate dev",
    "db:generate": "pnpm exec prisma generate",
    "db:studio": "pnpm exec prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@types/pdfkit": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.67.3",
    "date-fns": "^4.1.0",
    "ioredis": "^5.9.2",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "nanoid": "^5.1.6",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "pdfkit": "^0.17.2",
    "pg": "^8.18.0",
    "prisma": "^7.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.1",
    "stripe": "20.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.10.1"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "sharp",
      "msgpackr-extract",
      "unrs-resolver",
      "esbuild"
    ]
  }
}
